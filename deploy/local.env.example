# Template for deploy/<environment>.env — copy, fill in, do not commit.
#
# Values here are per-environment. Secrets are per-environment too, but they
# belong in the deployment platform's secret store rather than in this file;
# the entries below are named so a missing one is an obvious startup failure
# instead of a silent default.

# Environment selector. docker compose reads deploy/${DEPLOY_ENV}.env.
DEPLOY_ENV=local

# The application's own view of which environment it is running in: one of
# development, testing, production. Required with no default -- it used to
# default to production while every other default was a development
# convenience, so an incomplete environment produced a process that called
# itself production and was configured like a laptop.
ENV=development

# The privileged kitchen account's username. Required with no default: it used
# to be "chef", and a well-known account name is half of a credential.
CHEF_USERNAME=

# Host and origin allow-lists. Never "*": credentialed CORS with a wildcard
# origin lets any site read authenticated responses.
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:8443

# Database. POSTGRES_PASSWORD is a credential; source it from the secret store.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# At least 32 characters each. The application refuses to start otherwise.
JWT_SECRET_KEY=
OTP_HMAC_KEY=

# Directory holding server.crt and server.key for the proxy.
TLS_DIR=

# Outbound integrations. Empty allow-list means the feature is off.
ALLOWED_IMAGE_HOSTS=
CDN_TOKEN=
DELIVERY_API_BASE=
DELIVERY_API_TOKEN=
